{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xapi.to/schemas/worker-project.v1.json",
  "title": "xAPI Worker project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "worker",
    "wrangler",
    "build",
    "environments"
  ],
  "properties": {
    "$schema": {
      "const": "https://xapi.to/schemas/worker-project.v1.json"
    },
    "version": {
      "const": 1
    },
    "workerId": {
      "type": "string",
      "format": "uuid"
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "slug"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,47}[a-z0-9]$"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "template": {
          "enum": [
            "worker",
            "agent"
          ],
          "default": "worker"
        }
      }
    },
    "wrangler": {
      "$ref": "#/$defs/projectPath"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "output"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "$ref": "#/$defs/projectPath"
        },
        "main": {
          "description": "Entrypoint relative to build.output when output is a directory",
          "$ref": "#/$defs/projectPath"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory"
      ],
      "properties": {
        "directory": {
          "$ref": "#/$defs/projectPath"
        },
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "htmlHandling": {
          "enum": [
            "auto-trailing-slash",
            "force-trailing-slash",
            "drop-trailing-slash",
            "none"
          ]
        },
        "notFoundHandling": {
          "enum": [
            "none",
            "404-page",
            "single-page-application"
          ]
        },
        "runWorkerFirst": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^!?/"
              }
            }
          ]
        }
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/container"
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview",
        "production"
      ],
      "properties": {
        "preview": {
          "$ref": "#/$defs/environment"
        },
        "production": {
          "$ref": "#/$defs/environment"
        }
      }
    }
  },
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dailyBudgetUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "default": null,
          "description": "null means no user-selected daily budget limit; actual usage remains billable."
        },
        "healthCheck": {
          "type": "string",
          "pattern": "^/(?!/)[^\\s]*$",
          "maxLength": 500,
          "default": "/health"
        },
        "resources": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "secrets": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "queueConsumers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/queueConsumer"
          }
        },
        "crons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/container"
          }
        },
        "queueBindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Logical Wrangler queue name to existing managed resource binding; preserves Queue identity when producer aliases are renamed."
        },
        "defaultResourceLocation": {
          "type": "string",
          "enum": [
            "wnam",
            "enam",
            "weur",
            "eeur",
            "apac",
            "oc"
          ]
        },
        "placementMode": {
          "type": "string",
          "enum": [
            "off",
            "smart"
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "bindingName"
      ],
      "properties": {
        "type": {
          "enum": [
            "kv_namespace",
            "d1_database",
            "r2_bucket",
            "durable_object",
            "queue",
            "workflow"
          ]
        },
        "bindingName": {
          "type": "string",
          "minLength": 1
        },
        "className": {
          "type": "string",
          "pattern": "^[$_\\p{ID_Start}][$_\\u200C\\u200D\\p{ID_Continue}]*$"
        },
        "location": {
          "enum": [
            "wnam",
            "enam",
            "weur",
            "eeur",
            "apac",
            "oc"
          ]
        },
        "readReplication": {
          "enum": [
            "auto",
            "disabled"
          ]
        },
        "workflowName": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "durable_object"
              }
            }
          },
          "then": {
            "required": [
              "className"
            ]
          }
        },
        {
          "if": {
            "required": [
              "location"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "d1_database",
                  "r2_bucket"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "readReplication"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "d1_database"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "className"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "durable_object",
                  "workflow"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "workflowName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "workflow"
              }
            },
            "required": [
              "className"
            ]
          }
        }
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "className",
        "image"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "className": {
          "type": "string",
          "pattern": "^[$_\\p{ID_Start}][$_\\u200C\\u200D\\p{ID_Continue}]*$"
        },
        "image": {
          "type": "string",
          "maxLength": 512,
          "description": "Remote image in Cloudflare Registry, Docker Hub, ECR, or Google Artifact Registry"
        },
        "instanceType": {
          "anyOf": [
            {
              "enum": [
                "lite",
                "basic",
                "standard-1",
                "standard-2",
                "standard-3",
                "standard-4",
                "dev",
                "standard"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vcpu",
                "memory_mib",
                "disk_mb"
              ],
              "properties": {
                "vcpu": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "memory_mib": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "disk_mb": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            }
          ],
          "default": "lite"
        },
        "maxInstances": {
          "type": "integer",
          "minimum": 1,
          "default": 20
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "regions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "ENAM",
                  "WNAM",
                  "EEUR",
                  "WEUR",
                  "APAC",
                  "SAM",
                  "ME",
                  "OC",
                  "AFR"
                ]
              }
            },
            "jurisdiction": {
              "enum": [
                "eu",
                "fedramp"
              ]
            }
          }
        },
        "rolloutActiveGracePeriod": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "default": 0
        }
      }
    },
    "queueConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingName",
        "queue"
      ],
      "properties": {
        "bindingName": {
          "type": "string",
          "minLength": 1
        },
        "queue": {
          "type": "string",
          "minLength": 1
        },
        "deadLetterBinding": {
          "type": "string",
          "minLength": 1
        },
        "max_batch_size": {
          "type": "integer"
        },
        "max_batch_timeout": {
          "type": "integer"
        },
        "max_retries": {
          "type": "integer"
        },
        "retry_delay": {
          "type": "integer"
        },
        "max_concurrency": {
          "type": "integer"
        }
      }
    }
  }
}
